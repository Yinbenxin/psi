load("//bazel:psi.bzl", "psi_cc_binary", "psi_cc_library", "psi_cc_test")

package(default_visibility = ["//visibility:public"])

psi_cc_library(
    name = "circuit_psi",
    srcs = ["circuit_psi.cc"],
    hdrs = ["circuit_psi.h"],
    deps = [
        "//psi/ecdh:ecdh_logger",
        "//psi/cryptor:cryptor_selector",
        "//psi/utils:batch_provider_impl",
        "//psi/utils:communication",
        "//psi/utils:ec_point_store",
        "//psi/utils:recovery",
        "@com_google_absl//absl/strings",
        "@yacl//yacl/link",
        "@yacl//yacl/utils:parallel",
    ],
)

psi_cc_test(
    name = "circuit_psi_test",
    srcs = ["circuit_psi_test.cc"],
    deps = [
        ":circuit_psi",
        "//psi/utils:test_utils",
    ],
)


psi_cc_library(
    name = "he_unit",
    srcs = ["he_unit.cc"],
    hdrs = ["he_unit.h"],
    deps = [
        "@heu//heu/library/algorithms/paillier_zahlen:paillier_zahlen",
    ],
)

psi_cc_test(
    name = "he_unit_test",
    srcs = ["he_unit_test.cc"],
    deps = [
        ":he_unit",
        "@heu//heu/library/algorithms/paillier_zahlen:paillier_zahlen",
    ],
)

psi_cc_test(
    name = "he_pack_test",
    srcs = ["he_pack_test.cc"],
    deps = [
        "@heu//heu/library/algorithms/paillier_zahlen:paillier_zahlen",
    ],
)
